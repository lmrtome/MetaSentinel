/*
------------------------------------------------------------------------------------
MetaSentinel: A Metagenomic Workflow for Pathogen Detection and Genomic Surveillance
Config file
------------------------------------------------------------------------------------

*/

/*
------------------
Default parameters
------------------
*/

params {

    /* Input settings */

    input            = null
    
    /* Quality control settings */

    threads            = 4
    headcrop           = 30
    phredscore         = 10
    minlen             = 100

    /* Database settings */

    database_kraken2   = null
    database_diamond   = null
    database_amrfinder = null
    taxa_names         = null

    /* Assembly settings */

    run_assembly       = false
    read_type          = null


}

/* Output settings */

outputDir            = "./MetaSentinel_results"
workflow.output.mode = 'copy'

/* Conda settings */

conda.enabled = true
conda.channels = ['conda-forge', 'bioconda']

